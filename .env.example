# Copia a .env. El bootstrap genera passwords y ADMIN_TOKEN locales sin mostrarlos.
NODE_ENV=development
TZ=Europe/Madrid
DATABASE_URL=file:../storage/radio.db
STORAGE_ROOT=./storage
STATION_NAME="Radio AI"
DJ_PERSONA="Cercano, ágil y profesional. Radio musical en español de España."
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_TIMEOUT_MS=45000
WEATHER_PROVIDER=open-meteo
AEMET_API_KEY=
AEMET_MUNICIPALITY=20069
RADIO_LOCATION_NAME="Donostia / San Sebastián"
RADIO_LATITUDE=43.3183
RADIO_LONGITUDE=-1.9812
WEATHER_MAX_AGE_MINUTES=60
NEWS_MAX_AGE_HOURS=24
NEWS_SOURCES_JSON='[]'
FETCH_TIMEOUT_MS=10000
ICECAST_HOST=127.0.0.1
ICECAST_PORT=8000
ICECAST_MOUNT=/radio.mp3
ICECAST_SOURCE_PASSWORD=
ICECAST_ADMIN_PASSWORD=
ICECAST_RELAY_PASSWORD=
STREAM_PUBLIC_URL=http://localhost:8000/radio.mp3
LIQUIDSOAP_HOST=127.0.0.1
LIQUIDSOAP_PORT=1234
LIQUIDSOAP_TIMEOUT_MS=4000
TRACK_REPEAT_HOURS=24
ARTIST_REPEAT_MINUTES=90
JINGLE_MIN_TRACKS=5
JINGLE_MAX_TRACKS=8
CROSSFADE_SECONDS=5
DJ_HOURLY_ENABLED=true
DJ_PREPARE_MINUTES_BEFORE=5
DJ_ENQUEUE_MINUTES_BEFORE=1
DJ_TARGET_SECONDS=55
WORKER_INTERVAL_MS=5000
WORKER_HEARTBEAT_MAX_SECONDS=30
LIBRARY_SCAN_INTERVAL_SECONDS=300
MUSIC_QUEUE_TARGET=3
AUDIO_EXTENSIONS=.mp3,.m4a,.flac,.ogg,.wav
FFPROBE_PATH=ffprobe
GENERATED_RETENTION_DAYS=14
ADMIN_TOKEN=
ADMIN_ORIGIN=http://localhost:3000
